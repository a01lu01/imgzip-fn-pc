<Window x:Class="ImgZip.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ImgZip.Core">
  <Grid x:Name="Root" Background="{ThemeResource WindowBrush}" Loaded="Root_Loaded">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="{ThemeResource WindowBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
        <Image x:Name="AppTitleIcon" Width="16" Height="16" Stretch="Uniform" Source="Assets/app-icon.png" />
        <TextBlock Text="ImgZip · 图片压缩" FontSize="12" Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="26,18,26,18" Spacing="12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Spacing="4"><TextBlock Text="图片压缩" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="保留珍贵瞬间，腾出更多空间。" Style="{StaticResource SecondaryText}" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ComboBox x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="Theme_Changed" AutomationProperties.Name="外观主题" MinWidth="110"><ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" /></ComboBox>
            <Button Click="Settings_Click" IsEnabled="{Binding CanEdit}" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="设置" AutomationProperties.Name="打开设置"><FontIcon Glyph="&#xE713;" FontSize="16" /></Button>
          </StackPanel>
        </Grid>
        <InfoBar IsOpen="{Binding HasMessage}" Message="{Binding Message}" Severity="Informational" IsClosable="False" />
        <StackPanel Spacing="8">
          <Grid><TextBlock Text="来源" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" /><Button Content="清空" IsEnabled="{Binding CanEdit}" Click="Clear_Click" HorizontalAlignment="Right" Padding="6,2" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AccentTextBrush}" /></Grid>
          <Border Style="{StaticResource Surface}" Padding="14,12" AllowDrop="True" DragOver="Source_DragOver" Drop="Source_Drop">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Border Background="{ThemeResource SelectedBrush}" CornerRadius="7" Width="40" Height="40" VerticalAlignment="Center"><FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{ThemeResource AccentTextBrush}" /></Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding SourceTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SourceSummary}" Style="{StaticResource SecondaryText}" /><TextBlock Text="{Binding SourcePath}" FontSize="11" Foreground="{ThemeResource SubtextBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SourcePath}" /></StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Content="添加图片" IsEnabled="{Binding CanEdit}" Click="Files_Click" FontSize="12" Padding="10,6" /><Button Content="选择文件夹" IsEnabled="{Binding CanEdit}" Click="Folder_Click" FontSize="12" Padding="10,6" /></StackPanel>
            </Grid>
          </Border>
          <CheckBox Content="包含子文件夹" IsEnabled="{Binding CanEdit}" IsChecked="{Binding Recurse, Mode=TwoWay}" FontSize="12" MinHeight="26" />
          <TextBlock Text="压缩预设" Style="{StaticResource SectionHeading}" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ToggleButton Style="{StaticResource PresetButton}" IsEnabled="{Binding CanEdit}" IsChecked="{Binding JpegSelected}" Tag="archive-jpeg" Click="Preset_Click"><StackPanel Spacing="3"><TextBlock Text="JPG" FontSize="10" Foreground="{ThemeResource AccentTextBrush}" /><TextBlock Text="收藏 JPEG" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="90 质量 · 4000 px" Style="{StaticResource SecondaryText}" /></StackPanel></ToggleButton>
            <ToggleButton Grid.Column="1" Style="{StaticResource PresetButton}" IsEnabled="{Binding CanEdit}" IsChecked="{Binding WebpSelected}" Tag="archive-webp" Click="Preset_Click"><StackPanel Spacing="3"><TextBlock Text="WEBP" FontSize="10" Foreground="{ThemeResource AccentTextBrush}" /><TextBlock Text="收藏 WebP" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="90 质量 · 4000 px" Style="{StaticResource SecondaryText}" /></StackPanel></ToggleButton>
            <ToggleButton Grid.Column="2" Style="{StaticResource PresetButton}" IsEnabled="{Binding CanEdit}" IsChecked="{Binding ShareSelected}" Tag="webp-share" Click="Preset_Click"><StackPanel Spacing="3"><TextBlock Text="WEBP" FontSize="10" Foreground="{ThemeResource AccentTextBrush}" /><TextBlock Text="分享 WebP" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="80 质量 · 2560 px" Style="{StaticResource SecondaryText}" /></StackPanel></ToggleButton>
          </Grid>
          <Border Style="{StaticResource Surface}" Padding="13,10">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE7F4;" FontSize="19" Foreground="{ThemeResource SubtextBrush}" />
              <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="执行位置" FontSize="13" /><TextBlock Text="{Binding EngineStatus}" Style="{StaticResource SecondaryText}" /></StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="压缩引擎">
                <ToggleButton x:Name="EnginePcButton" Content="本机 PC" Tag="pc" Style="{StaticResource SegmentLeftButton}" Click="EngineButton_Click" />
                <ToggleButton x:Name="EngineNasButton" Content="NAS" Tag="nas" Style="{StaticResource SegmentRightButton}" Click="EngineButton_Click" />
              </StackPanel>
            </Grid>
          </Border>
          <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="{Binding CanEdit}" IsExpanded="{Binding AdvancedExpanded, Mode=TwoWay}">
            <Expander.Header><StackPanel Spacing="2"><TextBlock Text="高级设置" FontSize="13" /><TextBlock Text="{Binding AdvancedSummary}" Style="{StaticResource SecondaryText}" /></StackPanel></Expander.Header>
            <StackPanel Spacing="13">
              <Grid ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ComboBox Header="输出格式" SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="保持原格式" /><ComboBoxItem Content="JPEG" /><ComboBoxItem Content="WebP" /><ComboBoxItem Content="PNG" /></ComboBox>
                <NumberBox Grid.Column="1" Header="质量（0–100）" Value="{Binding Quality, Mode=TwoWay}" Minimum="0" Maximum="100" IsEnabled="{Binding CanSetQuality}" SpinButtonPlacementMode="Compact" />
                <ComboBox Grid.Row="1" Header="缩放方式" SelectedIndex="{Binding ResizeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="不缩放" /><ComboBoxItem Content="按长边" /><ComboBoxItem Content="按短边" /><ComboBoxItem Content="固定宽度" /><ComboBoxItem Content="固定高度" /></ComboBox>
                <NumberBox Grid.Row="1" Grid.Column="1" Header="尺寸（px · 等比缩放）" Value="{Binding Pixels, Mode=TwoWay}" Minimum="1" IsEnabled="{Binding CanResize}" SpinButtonPlacementMode="Compact" />
                <NumberBox Grid.Row="2" Header="目标体积（字节 · 0 为不限）" Value="{Binding MaxSize, Mode=TwoWay}" Minimum="0" IsEnabled="{Binding CanSetQuality}" SpinButtonPlacementMode="Compact" />
                <NumberBox Grid.Row="2" Grid.Column="1" Header="并行线程" Value="{Binding Threads, Mode=TwoWay}" Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="16"><CheckBox Content="无损压缩" IsChecked="{Binding Lossless, Mode=TwoWay}" FontSize="12" /><CheckBox Content="不放大小图" IsChecked="{Binding NoUpscale, Mode=TwoWay}" IsEnabled="{Binding CanResize}" FontSize="12" /><CheckBox Content="仅预演" IsChecked="{Binding DryRun, Mode=TwoWay}" FontSize="12" /></StackPanel>
              <TextBlock Text="无损模式不使用质量和目标体积参数，格式转换与缩放仍可能改变图片。预演只检查任务，不生成文件。" Style="{StaticResource SecondaryText}" />
            </StackPanel>
          </Expander>
        </StackPanel>
        <Grid ColumnSpacing="10" Margin="2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource SubtextBrush}" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="输出到新文件夹" FontSize="12" /><TextBlock Text="{Binding OutputPath}" FontSize="11" Foreground="{ThemeResource SubtextBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding OutputPath}" /></StackPanel><FontIcon Grid.Column="2" Glyph="&#xEA18;" FontSize="16" Foreground="{ThemeResource SuccessBrush}" /></Grid>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource WindowBrush}" Padding="26,12">
      <Grid RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" MaxHeight="240" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasTasks, Converter={StaticResource BoolVisibility}}">
          <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:CompressionTaskViewModel">
                <Border Style="{StaticResource Surface}" Padding="12,10" Margin="0,0,0,8">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding SourceTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Border Background="{ThemeResource SelectedBrush}" CornerRadius="4" Padding="6,1"><TextBlock Text="{Binding EngineName}" FontSize="10" Foreground="{ThemeResource AccentTextBrush}" /></Border>
                        <TextBlock Text="{Binding StateTitle}" FontSize="11" Foreground="{ThemeResource SubtextBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                      <ProgressBar Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                      <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{ThemeResource SubtextBrush}" />
                      <TextBlock Text="{Binding CurrentFile}" FontSize="11" Foreground="{ThemeResource SubtextBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" MinWidth="96">
                      <Button Content="取消" FontSize="11" Click="TaskCancel_Click" Visibility="{Binding CanCancel, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                      <Button Content="移除" FontSize="11" Click="TaskCancel_Click" Visibility="{Binding IsQueued, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                      <Button Content="重新检查" FontSize="11" Click="TaskInspect_Click" Visibility="{Binding IsUnknown, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                      <Button Content="打开输出" FontSize="11" Click="TaskOpen_Click" Visibility="{Binding CanOpenOutput, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                      <Button Content="失败详情" FontSize="11" Click="TaskFailures_Click" Visibility="{Binding HasFailures, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding TaskSummary}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
          <Button Grid.Column="1" Content="{Binding StartText}" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding CanStartTask}" Click="Start_Click" MinWidth="132" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
